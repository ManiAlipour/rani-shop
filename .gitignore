# ==========================================
# 📦 Dependencies (پکیج‌ها در ریشه و تمام زیرپوشه‌ها)
# ==========================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ==========================================
# 🏗️ Build Outputs (خروجی بیلد نود و نکست)
# ==========================================
# Next.js build
.next/
**/.next/
out/
**/out/
**/public/fonts

# Node.js / Express build (TypeScript dist)
dist/
**/dist/
build/
**/build/

# ==========================================
# 🔐 Environment Variables (متغیرهای محیطی)
# ==========================================
.env
.env*.local
.env.development
.env.production
.env.test
**/.env
**/.env*.local
**/.env.development
**/.env.production
**/.env.test

# اجازه به کامیت شدن فایل نمونه
!.env.example
!**/.env.example

# ==========================================
# ⚡ Caching & Turborepo
# ==========================================
.turbo
**/.turbo/
.vercel
**/.vercel/
.eslintcache
*.tsbuildinfo
.cache/
**/.cache/

# ==========================================
# 📝 Logs
# ==========================================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ==========================================
# 🧪 Coverage / Testing
# ==========================================
coverage/
**/coverage/
.nyc_output/

# ==========================================
# 📁 Uploads & Media (آپلودهای لوکال)
# ==========================================
uploads/
**/uploads/
public/uploads/
**/public/uploads/

# ==========================================
# 🗄️ Redis / Temp
# ==========================================
*.rdb
temp/
tmp/

# ==========================================
# 💻 OS & Editors
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
